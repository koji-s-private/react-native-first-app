# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# グローバルgitignoreで .claude ディレクトリ自体が除外される環境があるため、
# チーム共有すべきファイルだけ明示的に再include する
# (settings.local.json は個人設定のため引き続き除外)
!.claude/
!.claude/agents/
!.claude/agents/*.md
!.claude/settings.json
.claude/settings.local.json
